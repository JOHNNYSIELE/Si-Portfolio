rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'johnnysiele@gmail.com' ||
        request.auth.uid != null
      );
    }
    
    // Public Read-only Portfolio collections
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /skills/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /experience/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Contact Messages: Public submission, Admin read/manage
    match /messages/{docId} {
      allow create: if request.resource.data.email is string 
                    && request.resource.data.name is string;
      allow read, update, delete: if isAdmin();
    }
    
    // Visitor Subscriptions (for blog & skill notifications)
    match /subscribers/{docId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
